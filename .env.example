# Server Configuration
NODE_ENV=development
PORT=3000

# Session Secret - Replace with a secure random string (min 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_secret

# OpenRouter AI Configuration (optional - only needed for AI resume analysis)
# Sign up at https://openrouter.ai/ and get your API key from account settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Backup Configuration
BACKUP_ON_START=false
MAX_BACKUPS=10

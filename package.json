{
  "name": "college-placement-guide",
  "version": "1.0.0",
  "description": "A full-stack web application to help college students discover placement opportunities, manage profiles, build resumes, and track applications.",
  "type": "module",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "node scripts/init-storage.js && node scripts/seed-demo-data.js",
    "dev": "node --watch server/src/server.js",
    "storage:init": "node scripts/init-storage.js",
    "data:seed": "node scripts/seed-demo-data.js",
    "admin:create": "node scripts/create-admin.js",
    "backup": "node scripts/backup.js",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false"
  },
  "keywords": [
    "placement",
    "college",
    "resume",
    "jobs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-loki": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
